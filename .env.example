# Neon (serverless PostgreSQL) connection strings, from the Neon dashboard.
# DATABASE_URL is the POOLED connection (host contains "-pooler"); used at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/torch?sslmode=require"

# DIRECT_URL is the DIRECT connection (no "-pooler"); used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/torch?sslmode=require"

# --- Email (Resend) -------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=""

# The From address. For quick testing you can use Resend's shared sender
# below. In production use an address on a domain you've verified in Resend.
EMAIL_FROM="TORCHNOVA <onboarding@resend.dev>"

# Public URL of the site, used for links inside emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Team inbox that receives a notification for every demo request (optional).
DEMO_NOTIFY_EMAIL=""
