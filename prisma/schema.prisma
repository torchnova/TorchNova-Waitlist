// Prisma schema for Torch.
// Database: Neon (serverless PostgreSQL).
//   - DATABASE_URL: the pooled connection (host contains "-pooler") used at runtime.
//   - DIRECT_URL:   the direct connection used for migrations / introspection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // "public" holds the original waitlist (users). "website" holds everything
  // the product website collects, kept separate from the waitlist.
  schemas   = ["public", "website"]
}

enum Role {
  FOUNDER
  INVESTOR
  BOTH

  @@schema("public")
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  email            String   @unique
  role             Role?
  // Opaque token used for one-click unsubscribe / self-serve deletion.
  unsubscribeToken String   @unique @default(cuid()) @map("unsubscribe_token")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("users")
  @@schema("public")
}

// Demo requests from the "Request a demo" form. Duplicate emails are allowed —
// the same person may ask again for a different organization or later date.
model DemoRequest {
  id           String   @id @default(cuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String
  phone        String
  organization String
  role         String
  /// When the visitor accepted the Privacy Policy on the form.
  consentAt    DateTime @map("consent_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("demo_requests")
  @@schema("website")
}
