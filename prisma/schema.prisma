// Prisma schema for Torch.
// Database: Neon (serverless PostgreSQL).
//   - DATABASE_URL: the pooled connection (host contains "-pooler") used at runtime.
//   - DIRECT_URL:   the direct connection used for migrations / introspection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  FOUNDER
  INVESTOR
  BOTH
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  email            String   @unique
  role             Role?
  // Opaque token used for one-click unsubscribe / self-serve deletion.
  unsubscribeToken String   @unique @default(cuid()) @map("unsubscribe_token")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("users")
}
